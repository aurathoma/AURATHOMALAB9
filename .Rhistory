# start of function
ptrain <- function(y) {
# F(y) calculation
p <- (75 * y - y^3 + 250) / 500
# y value boundaries
p[y < -5] <- 0
p[y > 5] <- 1
# return p
return(p)
}
# call function and set y = 0
ptrain(0)
# start of function
mytrain <- function(a, b) {
# solve if y >= -5 and y <= 5
f <- function(y) {
ifelse(y >= -5 & y <= 5, (3 / 500) * (25 - y^2), 0)
}
# 2. Define the CDF function F(y) to compute between values of a and b
F_val <- function(y) {
p <- (75 * y - y^3 + 250) / 500
p[y < -5] <- 0
p[y > 5] <- 1
return(p)
}
# Calculate area P(a <= Y <= b) rounded to 4 decimal places
area <- round(F_val(b) - F_val(a), 4)
# Curve points for plot
x_curve <- seq(-10, 10, length.out = 1000)
y_curve <- f(x_curve)
# Plot the density curve
plot(
x_curve, y_curve,
type = "l",
col = "blue",
lwd = 2,
xaxt = "n",
xlab = "Y",
ylab = "Density",
main = "Time a train is late"
)
# Custom x-axis ticks
axis(1, at = c(-10, -5, a, 0, b, 5, 10))
# polygon between a and b
x_shade <- seq(a, b, length.out = 500)
y_shade <- f(x_shade)
polygon(
c(a, x_shade, b),
c(0, y_shade, 0),
col = "red",
border = "black"
)
# create line curves
lines(x_curve, y_curve, col = "blue", lwd = 2)
# add text displaying area value
text(
x = b + 1.5,
y = 0.10,
labels = paste0("Area = ", round(area, 2))
)
# Return the result
return(area)
}
# Call custom function with sample arguments for a and b
mytrain(a = 0, b = 5)
# start of function
rtrain <- function(n, u = 0.5) {
# Define your CDF-based objective function (F(x) - u = 0)
# Note: Adjust the CDF expression inside based on your specific distribution function from previous tasks
f <- function(x) {
pnorm(x, mean = 0, sd = 2.5) - u  # Example CDF minus u
}
# Plot the objective function for the given u
curve(f, from = -5, to = 5, xlab = "Y", ylab = "Objective function f", col = "black")
abline(h = 0, col = "blue")
# Find the root for the initial/default u value
root_result <- uniroot(f, interval = c(-5, 5))
print(root_result)
# Generate a random sample of size n
sample_v <- replicate(n, {
u_val <- runif(1) # Draw a random uniform value between 0 and 1
f_sample <- function(x) pnorm(x, mean = 0, sd = 2.5) - u_val
uniroot(f_sample, interval = c(-10, 10))$root
})
# Plot the histogram
hist(sample_v, probability = TRUE, breaks = 50, col = "blue",
main = "Simulation of the time a train is late", xlab = "Y")
curve(dnorm(x, mean = 0, sd = 2.5), col = "red", lwd = 2, add = TRUE)
# Return vector of samples
return(sample_v)
}
rtrain <- function(n, u = 0.5) {
# Define your CDF-based objective function using your custom ptrain logic
f <- function(x) {
# Custom CDF formula from your assignment
ptrain_val <- (75 * x - x^3 + 250) / 500
# Handle boundary conditions for CDF
ptrain_val[x < -5] <- 0
ptrain_val[x > 5] <- 1
return(ptrain_val - u)
}
# Plot the objective function for the given u across interval c(-5, 5)
curve(f, from = -5, to = 5, xlab = "Y", ylab = "Objective function f", col = "black")
abline(h = 0, col = "blue")
# Find the root for the initial/default u value
root_result <- uniroot(f, interval = c(-5, 5))
print(root_result)
# Generate a random sample of size n using replicate and uniroot (inverse transform sampling)
sample_v <- replicate(n, {
u_val <- runif(1) # Draw a random uniform value between 0 and 1
f_sample <- function(x) {
val <- (75 * x - x^3 + 250) / 500
val[x < -5] <- 0
val[x > 5] <- 1
return(val - u_val)
}
uniroot(f_sample, interval = c(-5, 5))$root
})
# Plot the histogram matching the custom PDF curve
hist(sample_v, probability = TRUE, breaks = 30, col = "blue",
main = "Simulation of the time a train is late", xlab = "Y", xlim = c(-5, 5))
# Overlay your custom PDF function (dtrain)
curve((75 - 3 * x^2) / 500, from = -5, to = 5, col = "red", lwd = 2, add = TRUE)
# Return vector of samples
return(sample_v)
}
# Run the completed function call matching the reference output
v <- rtrain(n = 100000, u = 0.5)
# View the first few values
head(v, 10)[cite: 8]
