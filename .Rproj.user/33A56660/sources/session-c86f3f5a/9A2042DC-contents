# start of function
ptrain <- function(y) {
  # F(y) calculation
  p <- (75 * y - y^3 + 250) / 500
  
  # y value boundaries
  p[y < -5] <- 0
  p[y > 5] <- 1
  
  # return p
  return(p)
}

