# dtrain {-}


```{r}
dtrain <- function(y) {
  # Derivative of the CDF 
  d <- (75 - 3 * y^2) / 500
  
  # Handle boundary conditions for a PDF. 
  d[y < -5 | y > 5] <- 0
  
  return(d)
}

# Test dtrain function
dtrain(0)
```

# qtrain {-}

```{r}
qtrain <- function(p) {
  # Validate that probabilities are between 0 and 1
  if (any(p < 0 | p > 1)) {
    stop("Probabilities must be between 0 and 1.")
  }
  
  # Use sapply to vectorize uniroot 
  sapply(p, function(prob) {
    if (prob == 0) return(-5)
    if (prob == 1) return(5)
    
    # Define the objective function
    f <- function(y) {
      ptrain(y) - prob
    }
    
    # Find the root within the interval 
    uniroot(f, interval = c(-5, 5))$root
  })
}

# run the qtrain function
qtrain(0.5)
```

