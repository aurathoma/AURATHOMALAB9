# # Task 6 {-}

rtrain <- function(n, w = 0.4) {
  
  # Define the objective function using the exact polynomial expression minus w
  f <- function(x) {
    (75 * x - x^3 + 250) / 500 - w
  }
  
  #  First plot: Objective function curve from -5 to 1
  curve(f, c(-5, 1), xlab = "Y", ylab = "Objective function f", col = "black")
  abline(h = 0, col = "blue")
  
  # Find and print the root for the initial w value
  root_result <- uniroot(f, interval = c(-5, 5))
  print(root_result)
  
  # Generate the random sample using replicate and uniroot
  sample_v <- replicate(n, {
    w_val <- runif(1) # Random uniform value between 0 and 1
    f_sample <- function(x) (75 * x - x^3 + 250) / 500 - w_val
    uniroot(f_sample, interval = c(-5, 5))$root
  })
  
  # Second plot: Histogram of the simulation with the PDF overlay
  hist(sample_v, probability = TRUE, breaks = 40, col = "blue", 
       main = "Simulation of the time a train is late", xlab = "Y", xlim = c(-5, 5))
  
  # Overlay the PDF curve (derivative of the CDF)
  curve((75 - 3 * x^2) / 500, from = -5, to = 5, col = "red", lwd = 2, add = TRUE)
  
  # Return vector of samples
  return(sample_v)
}

# Run the function matching the lab's template call
v <- rtrain(n = 10000, w = 0.4)

# View the first few values
head(v, 10)
